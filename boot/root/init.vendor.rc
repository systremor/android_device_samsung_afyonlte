on early-init

on init
    ## >>> BEGIN PARTITION MOUNT POINTS PREPARATION
    #

    # Modem Firmware partition for modem boot-loader application
    mkdir /mnt/modemfw 0700 system system

    # Modem Log partition
    mkdir /mnt/modemlog 0700 system system

    # Re-flashable partition for MODEM-FSA (MODEMFSRW)
    mkdir /mnt/modemfsrw 0700 system system

    # Non-reflashable partition for MODEM-FSA (MODEMFSRO)
    mkdir /mnt/modemfsro 0700 system system

    # Non-reflashable partition for MODEM-FSA (MODEMFSRO_FIX)
    mkdir /mnt/modemfsro_fix 0700 system system

    # securityro partition
    mkdir /mnt/securityro 0700 system system

    # securityrw partition
    mkdir /mnt/securityrw 0700 system system

    # create crashlog directory for crashlogd use
    mkdir /mnt/crashlog

    ## <<< END PARTITION MOUNT POINTS PREPARATION

on fs
    # Xfiles direcorty creation once mount done
    mkdir /mnt/modemlog/Xfiles 0700 system system

    # write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance

    # mount operations break folder owner
    chown system system /mnt/modemfsro_fix
    chown system system /mnt/modemfsro_fix/FIX
    chown system system /mnt/modemfsro
    chown system system /mnt/modemfsro/CALIB
    chown system system /mnt/modemfsrw
    chown system system /mnt/modemfsrw/CONF
    chown system system /mnt/modemfsrw/CONF/MCE
    chown system system /mnt/modemfsrw/CONF/MCE/MCElocal.CFG
    chown system system /mnt/modemfsrw/CONF/MCE/MCEnormal.CFG
    chown system system /mnt/modemfsrw/CONF/MCE/MCE.CFG
    chown system system /mnt/modemlog
    chown system system /mnt/securityro

    # Create Directory to store MODEM-FSA
    mkdir /mnt/modemfsrw/APE 0700 system system
    mkdir /mnt/modemfsrw/APE/modemfs 0700 system system


on post-fs

on post-fs-data
    # not need to initialize for TouchWiz by kyounghan.lee
    # Added for USB tethering
    # mkdir /data/misc/dhcp 0700 root root
    # end

    # Create Directory to store RIL trace
    mkdir /data/radio 0755 radio radio
    chmod 0775 /data/radio

    chown system system /sys/class/android_usb/android0/f_mass_storage/lun/file
    chmod 0660 /sys/class/android_usb/android0/f_mass_storage/lun/file
    chown system system /sys/class/android_usb/android0/f_rndis/ethaddr
    chmod 0660 /sys/class/android_usb/android0/f_rndis/ethaddr

    # Increase socket recv size (prevent message lost):
    write /proc/sys/net/core/rmem_max 3145728
    write /proc/sys/net/core/rmem_default 1048576

    # Increase socket send size:
    write /proc/sys/net/core/wmem_max 1048576

    # Change charging_status sysfs entry properties for atparser
    chown system system /sys/kernel/rmta_control/charging_status
    chmod 0644 /sys/kernel/rmta_control/charging_status

    # Change UART and ACM tty properties for atparser
    chown system system /sys/kernel/usb_atparser/uart_wakelock
    chown root system /sys/kernel/usb_atparser/at_isi_switch_buf
    chmod 0664 /sys/kernel/usb_atparser/at_isi_switch_buf

    # If there is no fs-post-data action in the init.<device>.rc file, you
    # must uncomment this line, otherwise encrypted filesystems
    # won't work.
    # Set indication (checked by vold) that we have finished this action
    # setprop vold.post_fs_data_done 1

on early-boot
    class_start renesas
    insmod /system/modules/pvrsrvkm.ko
    insmod /system/modules/shmobilelfb.ko
    start pvrsrvctl

on boot
    # basic dummy network init, has to be first
    ifup dummy-netdev

    chown system system /sys/class/graphics/fb0/device/lcdfreq/level
    chown system system /sys/class/backlight/panel/brightness
    chown system system /sys/class/sec_touchscreen/sec_touchkey/brightness

    chown system system /sys/class/leds/red/device/onoff
    chown system system /sys/class/leds/spotlight/brightness

    # Set default DNS1 and DNS2
    setprop net.rmnet0.dns1 208.67.222.222
    setprop net.rmnet0.dns2 208.67.220.220

    # Added to disable console log on boot up
    setprop persist.sys.consolelog 0

    # ntrace on / off by user setting
    # setprop persist.service.ntrace.enable 0

    # Audio setup
    start audio-setup

    chmod 0444 /proc/board_revision

    setprop ro.showcursor 1

    setprop ro.ril.mp_pval 0
    setprop ro.ril.mp_wval 0

    class_start modem

on property:init.svc.pvrsrvctl=stopped
    class_start main

on property:persist.sys.consolelog=1
    stop atparser
    start console

on property:persist.sys.consolelog=0
    stop console
    start atparser

# boot complete
on property:dev.bootcomplete=1
    write /sys/kernel/PowerManagement/boot_stop 1

# This property trigger has added to imitiate the previous behavior of "adb root".
# The adb gadget driver used to reset the USB bus when the adbd daemon exited,
# and the host side adb relied on this behavior to force it to reconnect with the
# new adbd instance after init relaunches it. So now we force the USB bus to reset
# here when adbd sets the service.adb.root property to 1.  We also restart adbd here
# rather than waiting for init to notice its death and restarting it so the timing
# of USB resetting and adb restarting more closely matches the previous behavior.
on property:service.adb.root=1
    write /sys/class/android_usb/android0/enable 0
    restart adbd
    write /sys/class/android_usb/android0/enable 1

on property:persist.service.ntrace.enable=1
    start mtraced_on

on property:persist.service.ntrace.enable=0
    restart mtraced_off

on property:sys.trace.control=*
    setprop persist.sys.trace.control $sys.trace.control
    restart mtraced_ctrl

on property:persist.sys.modem.reset=1
    start ErrorHandler

on property:persist.sys.modem.reset=0
    stop ErrorHandler

service modem-boot /system/bin/modem-boot -m /dev/block/mmcblk0p13
# service modem-boot /system/bin/modem-boot -m /mnt/modemfw/modem.bin
    class modem
    socket rilboot dgram 666 root radio
    user root
    group system radio
    oneshot

# Start ErrorHandler
service ErrorHandler /system/bin/modem-errorhandler smc0
    class modem
    group system sdcard_rw sdcard_r media_rw log
    disabled

# Start FSA
service modem-fsa /system/bin/modem-fsa smc0
    class modem
    group system radio

service atparser /system/bin/atparser  /dev/ttySC0
    class main
    socket dun_pppd2 dgram 660 system system
    socket dun_pppd1 dgram 660 system system
    user root
    group system radio inet input

service mtraced_on /system/bin/mtraced ntrace
    group system sdcard_rw sdcard_r media_rw log
    disabled
    oneshot

service mtraced_ctrl /system/bin/mtraced control
    group system sdcard_rw sdcard_r media_rw log
    disabled
    oneshot

service mtraced_off /system/bin/mtraced stop
    group system sdcard_rw sdcard_r media_rw log
    disabled
    oneshot

service pvrsrvctl /sbin/pvrsrvctl --start --no-module
    class renesas
    critical
    oneshot
    disabled

service mpro /vendor/bin/mpro2
    class renesas
    critical
    user system
    group graphics

service ionmapper /vendor/bin/ionmapper
    class renesas
    critical
    user system
    group graphics

service crashlogd /system/bin/crashlogd
    class core
    user system
    oneshot
    group system

service activateld /system/bin/activateld /dev/ttyGS1
    class main
    group system
    user root

service audio-setup /system/etc/rc.audio
    class core
    disabled
    critical
    oneshot

# Start secsrv
service secsrv /system/bin/secsrv
    class modem
    user system
    group system

service halt_system /system/etc/rc.halt_system
    class core
    disabled
    oneshot
