# mount                  point                   fstype    device                                                                            device2
/dev/block/mmcblk0p19    /system                 ext4      ro,noatime                                                                        wait
/dev/block/mmcblk0p12    /mnt/modemfsrw          ext4      nosuid                                                                            defaults
/dev/block/mmcblk0p3     /mnt/modemfsro          ext4      nosuid                                                                            defaults
/dev/block/mmcblk0p4     /mnt/modemfsro_fix      ext4      nosuid                                                                            defaults
# /dev/block/mmcblk0p13   /mnt/modemfw            ext4      nosuid                                                                            defaults
/dev/block/mmcblk0p14     /mnt/modemlog           ext4      nosuid,nodev                                                                      defaults
/dev/block/mmcblk0p15    /mnt/securityrw         ext4      nosuid                                                                            defaults
/dev/block/mmcblk0p5    /mnt/securityro         ext4      nosuid                                                                            defaults
/dev/block/mmcblk0p2     /efs                    ext4      noatime,nosuid,nodev,journal_async_commit,errors=panic                            wait,check
/dev/block/mmcblk0p18    /cache                  ext4      noatime,nosuid,nodev,journal_async_commit,errors=panic                            wait,check
tmpfs                    /mnt/crashlog           tmpfs     rw,nosuid,mode=0760,uid=1000,gid=1000                                             defaults

# data partition must be located at the bottom for supporting device encryption
/dev/block/mmcblk0p21    /data                   ext4      noatime,nosuid,nodev,discard,noauto_da_alloc,journal_async_commit,errors=panic    wait,check,encryptable=footer

