/system			ext4	/dev/block/mmcblk0p19	flags=display="System";backup=1;wipeingui;
/efs			ext4	/dev/block/mmcblk0p2	flags=display="EFS";
/cache			ext4	/dev/block/mmcblk0p18	flags=display="Cache";
/data			ext4	/dev/block/mmcblk0p21	flags=display="Data";backup=1;
/boot			emmc	/dev/block/mmcblk0p9	flags=display="Boot";backup=1;flashimg=1;
/recovery		emmc	/dev/block/mmcblk0p10	flags=display="Recovery";backup=1;flashimg=1;
/external_sd		auto	/dev/block/mmcblk1p1	flags=display="MicroSD card";wipeingui;removable
